# API 配置 (支持 OpenAI 协议的中转 API)
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"

# Agent 推理模型配置
VLLM_BASE_URL="https://api.deepseek.com/v1"  # 如果使用中转 API，请修改为中转地址，例如 "https://api.proxy.com/v1"
AGENT_LLM_MODEL="deepseek-chat"

# Judge 评测模型配置
JUDGE_BASE_URL="https://api.deepseek.com/v1"  # 中转 API 地址
JUDGE_LLM_MODEL="deepseek-chat"
